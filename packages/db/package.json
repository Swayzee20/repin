{
  "name": "@repin/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:generate": "node ./seed/generate-starter-movements.mjs",
    "test:security": "node --conditions=react-server --import ./test/register.mjs --test --test-concurrency=1 test/security.test.mjs test/formats.test.mjs",
    "test:seed": "pnpm --dir ../../apps/mobile exec tsx --test ../../packages/db/test/starter-movements-seed.test.mjs",
    "test:summary": "pnpm --dir ../../apps/mobile exec tsx --test ../../packages/db/test/summary.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@repin/types": "workspace:*",
    "@repin/validation": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "server-only": "^0.0.1"
  }
}
