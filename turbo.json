{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "ADMIN_USER_IDS",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT_API",
        "SENTRY_PROJECT_MOBILE",
        "EXPO_PUBLIC_SENTRY_DSN",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA",
        "EAS_BUILD_PROFILE",
        "EAS_BUILD_GIT_COMMIT_HASH"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
