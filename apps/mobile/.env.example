EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WEB_URL=https://repin.vercel.app
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Public DSN for the React Native Sentry project (EAS and Vercel repin-web).
# Leave unset to disable monitoring in local dev, Expo Go, and CI.
EXPO_PUBLIC_SENTRY_DSN=
# Optional EAS source-map upload. Do not commit the token. The native build
# still succeeds when these are unset. They are not read by the Vercel web build.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT_MOBILE=
