{
  "expo": {
    "name": "RepIn",
    "slug": "repin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "repin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RepIn to attach a photo to your workout."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.repin.mobile"
    },
    "android": {
      "package": "com.repin.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
