{
  "expo": {
    "name": "repin",
    "slug": "repin",
    "version": "1.0.0",
    "icon": "./assets/branding/icon.png",
    "orientation": "portrait",
    "scheme": "repin",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow repin to attach a photo to your workout.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFAF4",
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.repin.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B211C",
        "backgroundImage": "./assets/branding/adaptive-background.png",
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png"
      },
      "package": "com.repin.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/branding/favicon.png",
      "output": "single",
      "backgroundColor": "#FFFAF4",
      "themeColor": "#FFFAF4"
    },
    "extra": {
      "router": {},
      "reservedRegions": true,
      "eas": {
        "projectId": "e88e4ec2-8133-4ef9-9909-40dd1f6c9f3b"
      }
    }
  }
}
