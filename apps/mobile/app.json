{
  "expo": {
    "name": "RepIn",
    "slug": "repin",
    "version": "1.0.0",
    "icon": "./assets/branding/repin-app-icon.png",
    "orientation": "portrait",
    "scheme": "repin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RepIn to attach a photo to your workout."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/branding/repin-splash-logo.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.repin.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/branding/repin-app-icon.png"
      },
      "package": "com.repin.mobile",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/branding/repin-app-icon.png",
      "output": "single"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e88e4ec2-8133-4ef9-9909-40dd1f6c9f3b"
      }
    }
  }
}
