DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repin
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only key for signed workout photo URLs and account deletion
# (workout-photos removal and auth.admin.deleteUser). Prefer the modern secret
# key. Legacy projects can set SUPABASE_SERVICE_ROLE_KEY instead. Never put
# either value in an EXPO_PUBLIC_ variable or the mobile app.
SUPABASE_SECRET_KEY=your-server-only-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-server-only-service-role-key
MOBILE_WEB_ORIGINS=http://localhost:8081,https://repin.vercel.app
