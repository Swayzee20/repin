-- (void)updateRegions
+// layoutSubviews and the hinge callback run on the main thread inside UIKit.
+// experimental_flushSync set EventBeat's synchronous flag, so the next induce()
+// ran JS with executeNowOnTheSameThread while main was still in that layout.
+// JS that then called an Expo synchronous Function (dispatch_sync back to main)
+// deadlocked, and the scene-update watchdog killed the app (0x8BADF00D).
+// Defer the query to a later main-queue turn, coalesce a burst of layouts into
+// one read, and enqueue one asynchronous unique event. Never request a
+// synchronous event beat.
+- (void)scheduleRegionsUpdate
+{
+  if (_regionsUpdateScheduled || self.window == nil) {
+    return;
+  }
+  _regionsUpdateScheduled = YES;
+  NSUInteger generation = _recycleGeneration;
+  __weak __typeof(self) weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    ReservedRegionsView *view = weakSelf;
+    if (view == nil || view->_recycleGeneration != generation) {
+      return;
+    }
+    view->_regionsUpdateScheduled = NO;
+    [view emitRegions];
+  });
+}
