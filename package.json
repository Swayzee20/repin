{
  "name": "repin",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@repin/api",
    "dev:mobile": "turbo dev --filter=@repin/mobile",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "turbo": "^2.5.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.41.0"
  }
}

