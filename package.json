{
  "name": "repin",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@repin/api",
    "dev:mobile": "turbo dev --filter=@repin/mobile",
    "lint": "eslint . --max-warnings=0",
    "test:layout": "pnpm --dir apps/mobile run test:layout",
    "test:validation": "pnpm --filter @repin/validation test && pnpm --filter @repin/db test:summary && pnpm --filter @repin/db test:seed && pnpm --filter @repin/db test:pr",
    "test:security": "pnpm --filter @repin/db test:security",
    "typecheck": "turbo typecheck",
    "build:web": "pnpm --dir apps/mobile run build:web"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "turbo": "^2.5.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.41.0"
  }
}
